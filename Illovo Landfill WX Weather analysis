        "        ax.set_title(f'Seasonal {var}')\n",
        "        ax.set_xlabel('Season')\n",
        "        ax.set_ylabel(var)\n",
        "\n",
        "    plt.suptitle('Seasonal Analysis - Box Plots', y=1.02)\n",
        "    plt.tight_layout()\n",
