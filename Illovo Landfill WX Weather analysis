        "        'Extreme rain': (50, float('inf'))\n",
        "    }\n",
        "\n",
        "    # Categorize rainfall\n",
        "    rainfall_categories = []\n",
        "    for intensity in rainfall:\n",
        "        for category, (lower, upper) in thresholds.items():\n",
        "            if lower <= intensity < upper:\n",
        "                rainfall_categories.append(category)\n",
        "                break\n",
        "\n",
        "    # Count occurrences\n",
        "    category_counts = pd.Series(rainfall_categories).value_counts()\n",
