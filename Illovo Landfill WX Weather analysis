        "    data_seasonal = data.copy()\n",
        "    data_seasonal['Month'] = data_seasonal['DateTime'].dt.month\n",
        "    data_seasonal['Season'] = data_seasonal['Month'].map({\n",
        "        12: 'Summer', 1: 'Summer', 2: 'Summer',\n",
        "        3: 'Autumn', 4: 'Autumn', 5: 'Autumn',\n",
        "        6: 'Winter', 7: 'Winter', 8: 'Winter',\n",
        "        9: 'Spring', 10: 'Spring', 11: 'Spring'\n",
        "    })\n",
        "\n",
        "    # Seasonal summary for key variables\n",
        "    seasonal_vars = ['Temperature', 'Rainfall_Intensity', 'Wind_Speed_Uw', 'Relative_Humidity']\n",
        "    seasonal_summary = data_seasonal.groupby('Season')[seasonal_vars].agg(['mean', 'std']).round(2)\n",
        "\n",
        "    print(\"\\nSEASONAL ANALYSIS\")\n",
        "    print(\"=\" * 50)\n",
        "    print(seasonal_summary)\n",
        "\n",
        "    # Seasonal box plots\n",
