        "\n",
        "# Task 3: Threshold Analysis for Rainfall Intensity\n",
        "def analyze_rainfall_thresholds(data):\n",
        "    \"\"\"Analyze rainfall intensity thresholds\"\"\"\n",
        "\n",
        "    rainfall = data['Rainfall_Intensity'].dropna()\n",
        "\n",
        "    # Define threshold categories\n",
        "    thresholds = {\n",
        "        'No rain': (0, 0.1),\n",
        "        'Light rain': (0.1, 2.5),\n",
